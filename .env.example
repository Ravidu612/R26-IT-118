MQTT_DEVICE_OFFLINE_AFTER_MS=15000
IOT_WINDOW_MS=30000
IOT_MIN_WINDOW_SPAN_MS=28500
IOT_MIN_VALID_READINGS=20
IOT_MAX_READINGS_PER_DEVICE=600

NODE_ENV=development

